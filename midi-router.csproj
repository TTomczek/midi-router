<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621</TargetFramework>
    <RootNamespace>midi_router</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>

    <CsWinRTEnabled>true</CsWinRTEnabled>
    <CsWinRTWindowsSdkWinmd>true</CsWinRTWindowsSdkWinmd>
    <CsWinRTGenerateProjection>true</CsWinRTGenerateProjection>
    <CsWinRTGeneratedFilesDir>Generated</CsWinRTGeneratedFilesDir>

    <ApplicationIcon>Assets\midi-router.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="midi-router.Tests\midi-router.Tests.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Windows.Devices.Midi2" Version="0.99.63-devpreview.6" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>
  
  <ItemGroup>
    <Page Update="ThemeResources\*.xaml" Generator="MSBuild:Compile" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="midi-router.Tests\**\*.cs" />
    <EmbeddedResource Remove="midi-router.Tests\**\*" />
    <None Remove="midi-router.Tests\**\*" />
    <Page Remove="midi-router.Tests\**\*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="MidiMessageMonitor\**\*.cs" />
    <EmbeddedResource Remove="MidiMessageMonitor\**\*" />
    <None Remove="MidiMessageMonitor\**\*" />
    <Page Remove="MidiMessageMonitor\**\*.xaml" />
  </ItemGroup>

</Project>
