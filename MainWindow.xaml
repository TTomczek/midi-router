<Window x:Class="midi_router.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MIDI Router" Width="760" Height="500" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        AutomationProperties.Name="MIDI Router">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="False">
            <Button Width="42" Height="42" Padding="0" Content="⚙"
                    VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                    ToolTip="Settings"
                    AutomationProperties.Name="Settings"
                    AutomationProperties.HelpText="Open appearance settings"
                    Click="SettingsButton_Click">
                <Button.ContextMenu>
                    <ContextMenu x:Name="SettingsMenu" Background="{DynamicResource SurfaceBrush}"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 Opened="SettingsMenu_Opened">
                        <MenuItem Header="Appearance" Foreground="{DynamicResource MutedTextBrush}"
                                  IsEnabled="False"/>
                        <Separator/>
                        <MenuItem x:Name="LightMenuItem" Header="Light" Tag="Light"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  IsCheckable="True" Click="AppearanceMenuItem_Click"/>
                        <MenuItem x:Name="DarkMenuItem" Header="Dark" Tag="Dark"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  IsCheckable="True" Click="AppearanceMenuItem_Click"/>
                        <MenuItem x:Name="OsDefaultMenuItem" Header="OS default" Tag="OsDefault"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  IsCheckable="True" Click="AppearanceMenuItem_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="MIDI Router" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Connected MIDI devices" Margin="0,3,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13"/>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Margin="0,28,0,16" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="16,12,16,4" LastChildFill="False">
                    <TextBlock Text="Available inputs" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock DockPanel.Dock="Right" Text="Auto-refresh enabled"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <ListView x:Name="DeviceList" Grid.Row="1" ItemsSource="{Binding Devices}"
                          Foreground="{DynamicResource PrimaryTextBrush}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="DEVICE" DisplayMemberBinding="{Binding Name}" Width="420"/>
                            <GridViewColumn Header="PROTOCOL" DisplayMemberBinding="{Binding Version}" Width="180"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
        <TextBlock Grid.Row="2" DataContext="{Binding ElementName=DeviceList, Path=DataContext}"
                   Text="{Binding StatusMessage}" Foreground="{DynamicResource SecondaryTextBrush}"
                   FontSize="12" Margin="2,0,0,0"/>
    </Grid>
</Window>
