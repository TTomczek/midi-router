<Window x:Class="midi_router.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MIDI Router" Width="860" Height="540" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        AutomationProperties.Name="MIDI Router">
    <Grid Margin="32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="False">
            <ComboBox x:Name="ProfileSelector" DockPanel.Dock="Right" Width="150" Height="30"
                      Margin="0,3,10,0" ItemsSource="{Binding Profiles}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding ActiveProfile, Mode=OneWay}"
                      SelectionChanged="ProfileSelector_SelectionChanged"
                      ToolTip="Profile" AutomationProperties.Name="Profile">
                <ComboBox.ContextMenu>
                    <ContextMenu Background="{DynamicResource SurfaceBrush}"
                                 Foreground="{DynamicResource PrimaryTextBrush}">
                        <MenuItem Header="New profile" Click="NewProfileMenuItem_Click"/>
                        <MenuItem Header="Rename profile" Click="RenameProfileMenuItem_Click"/>
                        <MenuItem Header="Delete profile" Click="DeleteProfileMenuItem_Click"/>
                    </ContextMenu>
                </ComboBox.ContextMenu>
            </ComboBox>
            <Button DockPanel.Dock="Right" Width="30" Height="30" Margin="0,3,6,0"
                    Content="+" ToolTip="New profile" AutomationProperties.Name="New profile"
                    Click="NewProfileMenuItem_Click"/>
            <Button DockPanel.Dock="Right" Width="36" Height="36" Padding="0" Content="⚙"
                    VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                    Background="Transparent" BorderBrush="Transparent"
                    ToolTip="Settings"
                    AutomationProperties.Name="Settings"
                    AutomationProperties.HelpText="Open appearance settings"
                    Click="SettingsButton_Click">
                <Button.ContextMenu>
                    <ContextMenu x:Name="SettingsMenu" Background="{DynamicResource SurfaceBrush}"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 Opened="SettingsMenu_Opened">
                        <MenuItem Header="Appearance" Foreground="{DynamicResource MutedTextBrush}"
                                  IsEnabled="False"/>
                        <Separator/>
                        <MenuItem x:Name="LightMenuItem" Header="Light" Tag="Light"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  IsCheckable="True" Click="AppearanceMenuItem_Click"/>
                        <MenuItem x:Name="DarkMenuItem" Header="Dark" Tag="Dark"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  IsCheckable="True" Click="AppearanceMenuItem_Click"/>
                        <MenuItem x:Name="OsDefaultMenuItem" Header="OS default" Tag="OsDefault"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  IsCheckable="True" Click="AppearanceMenuItem_Click"/>
                        <Separator/>
                        <MenuItem x:Name="MinimizeToTrayMenuItem" Header="Minimize to tray"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  IsCheckable="True" Click="MinimizeToTrayMenuItem_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="MIDI Router" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Connected MIDI devices" Margin="0,4,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Margin="0,24,0,14" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="18,14,18,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="AVAILABLE INPUTS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="Auto-refresh enabled" Margin="0,3,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="PROTOCOL" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock Grid.Column="2" Text="CHANNEL" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </Grid>
                <ListView x:Name="DeviceList" Grid.Row="1" ItemsSource="{Binding Devices}"
                          Foreground="{DynamicResource PrimaryTextBrush}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Stretch"
                          PreviewMouseLeftButtonDown="DeviceList_PreviewMouseLeftButtonDown">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            <Setter Property="Padding" Value="8,10"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="7"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background"
                                                        Value="{DynamicResource HoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background"
                                                        Value="{DynamicResource SelectedBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Margin="0,0,8,0"
                                             VerticalAlignment="Center"
                                             AutomationProperties.Name="MIDI activity">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill"
                                                        Value="{DynamicResource DeviceActivityInactiveBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Fill"
                                                                Value="{DynamicResource DeviceActivityActiveBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Version}"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="2" SelectedValue="{Binding DisplayChannel, Mode=OneWay}"
                                          ItemsSource="{Binding DataContext.ChannelOptions,
                                              RelativeSource={RelativeSource AncestorType=ListView}}"
                                          Foreground="{DynamicResource PrimaryTextBrush}"
                                          Background="{DynamicResource ElevatedSurfaceBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}"
                                          SelectionChanged="ChannelComboBox_SelectionChanged"
                                          AutomationProperties.Name="MIDI channel"
                                          AutomationProperties.HelpText="Select the MIDI channel assigned to this device"
                                          Width="64">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="ChannelText"
                                                       Text="{Binding}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <DataTemplate.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ComboBoxItem}},
                                                        Path=IsHighlighted}"
                                                    Value="True">
                                                    <Setter TargetName="ChannelText"
                                                            Property="Foreground"
                                                            Value="{DynamicResource AccentTextBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger
                                                    Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ComboBoxItem}},
                                                        Path=IsSelected}"
                                                    Value="True">
                                                    <Setter TargetName="ChannelText"
                                                            Property="Foreground"
                                                            Value="{DynamicResource AccentTextBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
        <TextBlock Grid.Row="2" DataContext="{Binding ElementName=DeviceList, Path=DataContext}"
                   Text="{Binding StatusMessage}" Foreground="{DynamicResource SecondaryTextBrush}"
                   FontSize="12" Margin="2,0,0,2"/>
    </Grid>
</Window>
