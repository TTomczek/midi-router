<Window x:Class="midi_router.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MIDI Router" Width="640" Height="420">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Connected MIDI devices"
                   FontSize="22"
                   FontWeight="SemiBold"/>
        <ListView Grid.Row="1" Margin="0,16,0,12" ItemsSource="{Binding Devices}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="360"/>
                    <GridViewColumn Header="MIDI Version" DisplayMemberBinding="{Binding Version}" Width="140"/>
                </GridView>
            </ListView.View>
        </ListView>
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="DarkSlateGray"/>
    </Grid>
</Window>
