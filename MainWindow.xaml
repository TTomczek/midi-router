<Window x:Class="midi_router.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:midi_router"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MIDI Router" Height="560" Width="820"
        MinHeight="420" MinWidth="620"
        Background="#F5F7FB"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#315EF7" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.65" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>

    <Grid Margin="42">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,28">
            <Button Content="Aktualisieren" Click="RefreshButton_Click" DockPanel.Dock="Right" />
            <StackPanel>
                <TextBlock Text="MIDI Router" FontSize="30" FontWeight="Bold" Foreground="#182230" />
                <TextBlock Text="Verfügbare Eingabegeräte" FontSize="15" Foreground="#64748B" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,18">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#E8EEFF" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static local:DeviceListState.Empty}">
                            <Setter Property="Background" Value="#F3F4F6" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static local:DeviceListState.Error}">
                            <Setter Property="Background" Value="#FEF2F2" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLoadingState}" Value="True">
                            <Setter Property="Background" Value="#EEF2FF" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <TextBlock Text="●" Foreground="#315EF7" FontSize="18" DockPanel.Dock="Left" Margin="0,0,12,0" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="#334155" FontSize="14"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DeviceCount, StringFormat={}{0} Geräte}" Foreground="#315EF7" FontWeight="SemiBold" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <ListBox ItemsSource="{Binding Devices}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="10" Padding="18,15" BorderBrush="#E2E8F0" BorderThickness="1">
                            <DockPanel>
                                <Border Width="38" Height="38" CornerRadius="19" Background="#EEF2FF" DockPanel.Dock="Left" Margin="0,0,14,0">
                                    <TextBlock Text="♫" FontSize="21" Foreground="#315EF7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="#182230" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding VersionDisplayName}" FontSize="12" Foreground="#64748B" />
                                        <TextBlock Text="  |  Ausgabe-Kanal:" FontSize="12" Foreground="#64748B" />
                                        <ComboBox Width="58" Margin="6,0,0,0"
                                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.ChannelNumbers}"
                                                  SelectedItem="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=DataContext.TargetChannel, Mode=TwoWay}"
                                                  SelectionChanged="ChannelComboBox_SelectionChanged" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Visibility="Collapsed">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Text" Value="" />
                        <Setter Property="Foreground" Value="#64748B" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmptyState}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Text" Value="Keine Eingabegeräte gefunden. Schließe ein MIDI-Gerät an und aktualisiere die Liste." />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsErrorState}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="#B91C1C" />
                                <Setter Property="Text" Value="Geräteliste konnte nicht geladen werden. Bitte erneut aktualisieren." />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
